# Configura estos valores en Render. No subas un archivo .env con secretos.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_key_o_clave_del_servidor
ALLOWED_ORIGINS=https://tu-frontend.vercel.app
# Solo si se deben aceptar deployments Preview de Vercel:
ALLOW_VERCEL_PREVIEWS=false

# Copia este archivo como `.env` para desarrollo local y completa los valores.
# En Render, configura las mismas variables como secretos del servicio.
# Nunca subas `.env` ni expongas la clave de servicio en el frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
ALLOWED_ORIGINS=https://tu-frontend.vercel.app
# Solo si se deben aceptar deployments Preview de Vercel:
ALLOW_VERCEL_PREVIEWS=false
